---
import App from '../components/App';
import { loadSiteCms } from '../lib/cms/loadWorks';

export const prerender = false;

const cms = await loadSiteCms();
const { works, tags, intro } = cms;

// Cache the rendered HTML at the CDN edge. Data only changes when the
// Google Sheet is edited, so a short s-maxage plus a long
// stale-while-revalidate keeps the site fresh while making repeat visits
// (and cold starts) much faster.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=300, stale-while-revalidate=3600'
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://pub-ab92f061862e4c32b9117317c7b77334.r2.dev" crossorigin />
    <link rel="dns-prefetch" href="https://pub-ab92f061862e4c32b9117317c7b77334.r2.dev" />
    <link rel="stylesheet" href="/theatre-works.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>anyway</title>
    <meta
      name="description"
      content="Any — ambient music archive with video grid, tag search, and contact."
    />
  </head>
  <body>
    <div class="theatre-works">
      <div class="fixed-viewer">
        <div class="viewer-container">
          <div class="video-section full-width">
            {works.length === 0 ? (
              <div class="loading">
                <p>No works found</p>
              </div>
            ) : (
              <App works={works} tags={tags} intro={intro} client:only="react" />
            )}
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
